# Netlify Cache Control & Security Headers for Royal Aesthetic & Laser Clinic

# 1. Immutable static production assets generated by Vite
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# 2. Optimized images, WebP assets and vector icons
/assets/aistudio/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/aistudio/*.png
  Cache-Control: public, max-age=31536000, immutable

# 3. Dynamic HTML files and Prerendered Static Pages (always revalidate to get latest version)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# 4. XML Sitemap & Robots.txt
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate
/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate
